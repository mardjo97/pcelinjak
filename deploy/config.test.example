# Copy to config.test (or config.test.local) and fill in for TEST environment.
# Test env should use a separate DEPLOY_PATH and compose project name.

# Required
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=/opt/pcelinjak-test

# Optional: path to private key
# SSH_KEY=C:\Users\you\.ssh\id_ed25519
# Git: kao prod — origin na serveru SSH. Jednokratno sa lokalnog računara:
#   ssh DEPLOY_USER@DEPLOY_HOST "cd /opt/pcelinjak-test && git remote set-url origin git@github.com:mardjo97/pcelinjak.git"
# Opciono u configu: SKIP_GIT_PULL=1, GIT_ORIGIN_SSH=... (vidi config.example).

# Compose isolation for test env
COMPOSE_PROJECT_NAME=pcelinjak-test
COMPOSE_FILES=docker-compose.yml
DEPLOY_BACKEND_URL=http://your-server-ip:8082
BACKEND_PORT=8082
MYSQL_PORT=3307
BACKEND_LOG_DIR=backend-test
PCELINJAK_MAIL_BASE_URL=http://your-server-ip:8082
PCELINJAK_MYSQL_VOLUME_NAME=pcelinjak-test_mysql_data

# Optional: app-specific env
# PCELINJAK_JWT_SECRET=
# MAIL_PASSWORD=
# NOTIFICATION_SERVICE_URL=
# NOTIFICATION_API_KEY=
# NOTIFICATION_ENABLED=true
# SENTRY_DSN=
# SENTRY_ENABLED=true

# Optional S3 backup for test env
# S3_BUCKET=pcelinjak-test-backups
# S3_REGION=eu-central-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_PREFIX=pcelinjak-test/mysql
# LOG_S3_PREFIX=pcelinjak-test/logs
# BACKUP_LOGS_ENABLED=1
# LOG_SOURCE_DIR=/opt/pcelinjak-test/logs/backend-test
# BACKUP_CRON=30 3 * * *
# BACKUP_NOTIFY_EMAIL=
# S3_APPLY_LIFECYCLE=1
