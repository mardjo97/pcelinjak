# Copy to config (or config.local) and fill in. Do not commit config with secrets.
# DEPLOY_HOST=your-server-ip
# DEPLOY_USER=root
# DEPLOY_PATH=/opt/pcelinjak
# SSH_KEY=

# Required
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=/opt/pcelinjak

# Optional: path to private key (default: ~/.ssh/id_rsa or let SSH use agent)
# SSH_KEY=C:\Users\you\.ssh\id_ed25519
# Optional: preskoci git pull na serveru (deploy.ps1); sa -Pull ipak pokusaj pull
# SKIP_GIT_PULL=1
# Optional: ako je origin na serveru https://github.com, pre pull-a prebaci na SSH
# GIT_ORIGIN_SSH=git@github.com:mardjo97/pcelinjak.git
# Optional: compose project i fajlovi (za prod obicno ne treba)
# COMPOSE_PROJECT_NAME=pcelinjak
# COMPOSE_FILES=docker-compose.yml
# Ime Docker volume-a za MySQL
# PCELINJAK_MYSQL_VOLUME_NAME=pcelinjak_mysql_data
# Optional: URL koji deploy ispisuje na kraju
# DEPLOY_BACKEND_URL=http://your-server-ip:8082
# Optional: portovi i log dir za compose varijable
# Na shared hostu (sa Farmom): NE koristi 8081/3306 — farma ih drži.
# Predlog prod: BACKEND_PORT=8082, MYSQL_PORT=3310
# BACKEND_PORT=8082
# MYSQL_PORT=3310
# MySQL credentials (OBAVEZNO promeniti u produkciji)
# MYSQL_ROOT_PASSWORD=strong-root-password
# MYSQL_DATABASE=pcelinjak
# MYSQL_USER=pcelinjak
# MYSQL_PASSWORD=strong-app-password
# BACKEND_LOG_DIR=backend
# PCELINJAK_MAIL_BASE_URL=http://your-server-ip:8082
# Trajanje JWT u sekundama (podrazumevano 365 dana)
# PCELINJAK_JWT_EXPIRATION_SECONDS=31536000
# JWT secret (min 32 chars, obavezno promeniti)
# PCELINJAK_JWT_SECRET=replace-with-strong-random-secret
# Ops-dashboard /admin/stats (X-Admin-Key); leave empty to leave endpoint open
# PCELINJAK_ADMIN_KEY=

# Optional: Gmail App lozinka ili Loopia mailbox lozinka
# MAIL_FROM=noreply@hexatech.rs
# MAIL_HOST=mailcluster.loopia.se
# MAIL_PORT=587
# MAIL_USERNAME=noreply@hexatech.rs
# MAIL_PASSWORD=replace-with-mailbox-password

# Optional: notification-service (FCM podsetnici)
# Na beeback hostu: notification-service slusa 8087 (8085 = cvmaker-frontend)
# NOTIFICATION_SERVICE_URL=http://host.docker.internal:8087
# NOTIFICATION_API_KEY=
# NOTIFICATION_ENABLED=true

# Optional: Sentry DSN za error alerting
# SENTRY_DSN=
# SENTRY_ENABLED=true

# -------- S3 backup (opciono, za -SetupBackup) --------
# S3_BUCKET=pcelinjak-prod-backups
# S3_REGION=eu-central-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Optional: za S3-kompatibilne servise (npr. Backblaze/Wasabi/MinIO)
# S3_ENDPOINT=
# Optional: prefix u bucket-u
# S3_PREFIX=pcelinjak/mysql
# Optional: prefix za backup logova
# LOG_S3_PREFIX=pcelinjak/logs
# Optional: ukljuci backup logova (1/0), default 1
# BACKUP_LOGS_ENABLED=1
# Optional: izvor log direktorijuma na serveru, default <DEPLOY_PATH>/logs/backend
# LOG_SOURCE_DIR=
# Optional: cron schedule (default 30 2 * * *)
# BACKUP_CRON=30 2 * * *
# Optional: emergency local backup cron (default every 5 minutes)
# LOCAL_BACKUP_CRON=*/5 * * * *
# Optional: koliko minuta lokalni dumpovi ostaju (default 180)
# LOCAL_BACKUP_KEEP_MINUTES=2880
# Optional: snimi novi lokalni dump samo ako se razlikuje od prethodnog (0/1, default 0)
# LOCAL_BACKUP_SAVE_ONLY_ON_CHANGE=1
# Optional: email status (samo notifikacija, ne attachment)
# BACKUP_NOTIFY_EMAIL=
# Optional: primeni lifecycle 90d automatski (1/0), default 1
# S3_APPLY_LIFECYCLE=1
