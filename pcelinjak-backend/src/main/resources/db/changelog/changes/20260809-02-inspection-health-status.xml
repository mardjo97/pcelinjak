<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260809-02-inspection-health-status" author="dmarkovic" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="inspection"/>
                <not>
                    <columnExists tableName="inspection" columnName="health_status"/>
                </not>
            </and>
        </preConditions>
        <comment>Add health_status; migrate old temper checklist values to calm/nervous/aggressive</comment>
        <addColumn tableName="inspection">
            <column name="health_status" type="VARCHAR(32)" defaultValue="NOT_CHECKED">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            UPDATE inspection SET temper_status = CASE temper_status
                WHEN 'GOOD' THEN 'CALM'
                WHEN 'ATTENTION' THEN 'NERVOUS'
                WHEN 'CRITICAL' THEN 'AGGRESSIVE'
                ELSE temper_status
            END
        </sql>
    </changeSet>

</databaseChangeLog>
